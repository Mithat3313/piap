[Unit]
Description=AP-VPN Bluetooth LE management agent (GATT)
After=bluetooth.service ap-firewall.service
Requires=bluetooth.service
BindsTo=bluetooth.service
# Runs even without an AP (ap-firewall is optional) - it is needed exactly when the AP is broken.

[Service]
Type=simple
ExecStartPre=/usr/sbin/rfkill unblock bluetooth
ExecStartPre=-/usr/bin/timeout 5 /usr/bin/script -qc "btmgmt connectable on" /dev/null
ExecStart=/usr/bin/python3 /opt/ap-vpn/bin/ap-ble-agent.py
Restart=always
RestartSec=5
# ap-ctl manages hostapd/wg/dnsmasq -> root is required
User=root
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
