[Unit]
Description=AP-VPN firewall + policy routing
# Must run AFTER Docker: when Docker starts it can recreate the DOCKER-USER
# chain and our rules would be lost.
After=network-online.target docker.service wg-quick@wg0.service wg-quick@wg1.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/ap-vpn/bin/ap-firewall.sh
# Do NOT release the kill switch when stopped - the safe side is to keep the rules.
# Use /opt/ap-vpn/bin/ap-uninstall.sh for a full cleanup.
ExecStop=/bin/true

[Install]
WantedBy=multi-user.target
