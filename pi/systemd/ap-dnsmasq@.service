[Unit]
Description=AP slot %i: DHCP+DNS (dnsmasq)
After=ap-wlan@%i.service ap-firewall.service
Requires=ap-wlan@%i.service

[Service]
Type=simple
ExecStart=/usr/sbin/dnsmasq -k --conf-file=/etc/ap-vpn/slots/%i.dnsmasq.conf --pid-file=/run/ap-dnsmasq-%i.pid
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
