# Slot __SLOT__ — __DESC__
# A slot = one RADIO + one subnet (AP_NET) + one exit + one routing table.
# The radio is identified by AP_MAC, not by its kernel name: AP_IF is only the name that MAC had
# last time. ap-ifsync.sh follows the MAC, so re-plugging an adapter or a different enumeration
# order keeps this slot on its own device. Another adapter never inherits this slot - it gets its
# own (ap-slot-new.sh), which means its own subnet, its own SSID and its own exit.
#
# MODE=vpn     clients exit ONLY through WG_IF. No tunnel = no internet (kill switch).
# MODE=direct  clients exit through the LAN with no VPN at all. Deliberate and pinned; a vpn slot
#              never falls back to this.
# Generated by ap-slot-new.sh; MODE/PROFILE/PIN_*/AP_MAC/AP_IF are managed by ap-ctl and ap-ifsync
# (do not edit them by hand - the pin would no longer match and the SSID would stop).
ENABLED=1
MODE=__MODE__
AP_IF=__AP_IF__
AP_MAC=__AP_MAC__
AP_NET=__NET__.0/24
AP_ADDR=__NET__.1/24
AP_GW=__NET__.1
AP_POOL_LO=__NET__.50
AP_POOL_HI=__NET__.200
AP_TEST_SRC=__NET__.50
WG_IF=wg__IDX__
TABLE=__TABLE__
PRIO_WGSRC=__PRIO0__
PRIO_APNET=__PRIO1__
PRIO_BLACKHOLE=__PRIO2__
PROFILE=
DNSMASQ_CONF=/etc/ap-vpn/slots/__SLOT__.dnsmasq.conf
DNSMASQ_UNIT=ap-dnsmasq@__SLOT__
HOSTAPD_UNIT=ap-hostapd@__SLOT__
