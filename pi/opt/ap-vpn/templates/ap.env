# /etc/ap-vpn/ap.env — global settings (single source of truth).
# Per-slot settings live in /etc/ap-vpn/slots/<slot>.env, generated by ap-slot-new.sh.

# The Pi's own internet/management interface. AP and tunnel rules NEVER touch it.
LAN_IF=__LAN_IF__

# A tunnel is considered "stale" when its last handshake is older than this (seconds).
# With keepalive=25 and REKEY_AFTER_TIME=120 a healthy peer can reach ~145 s and a lossy
# rekey ~210 s; 300 is the right threshold, 180 produces false alarms.
HS_MAX_AGE=300
# Minimum interval (seconds) between two tunnel rebuilds by the watchdog (flap protection).
RESTART_COOLDOWN=600

# ap-verify: also confirm that the Pi's own services are unaffected. Space-separated,
# "http:PORT" (HTTP reply on the LAN address) or "tcp:PORT" (listening socket). Empty = skip.
#   example: HOST_CHECKS="http:8123 tcp:1883"
HOST_CHECKS=

# --- Bluetooth management agent (ap-ble-agent) ---
# 1 = GATT characteristics require an encrypted/bonded link (recommended). 0 = application layer only.
BLE_ENCRYPT=1
# Name shown in the LE advertisement (change with: ap-ctl ble setname)
BLE_NAME=PiAP

# --- Web panel (HTTPS) ---
WEB_PORT=8443
